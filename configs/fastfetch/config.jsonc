// Inspired by nitch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "default"
    }
  },
  "modules": [
    {
      "key": "{#}   _  ___      ____  ____",
      "type": "custom"
    },
    {
      "key": "{#}  / |/ (_)_ __/ __ \\/ __/",
      "type": "custom"
    },
    {
      "key": "{#magenta} /    / /\\ \\ / /_/ /\\ \\  ",
      "type": "custom"
    },
    {
      "key": "{#blue}/_/|_/_//_\\_\\\\____/___/  ",
      "type": "custom"
    },
    {
      "key": "{#} ",
      "type": "custom"
    },
    {
      "key": "  ╭───────────╮",
      "type": "custom"
    },
    {
      "key": "  │ {#red}{#} user    {#keys}│",
      "type": "title",
      "format": "{#red}{user-name}{#}"
    },
    {
      "key": "  │ {#yellow}󰇅{#} hname   {#keys}│",
      "type": "title",
      "format": "{#yellow}{host-name}{#}"
    },
    {
      "key": "  │ {#green}{icon}{#} distro  {#keys}│",
      "type": "os",
      "format": "{#green}{pretty-name}{#}"
    },
    {
      "key": "  │ {#cyan}{#} kernel {#keys} │",
      "type": "kernel",
      "format": "{#cyan}{release}{#}"
    },
    {
      "key": "  │ {#blue}{#} uptime  {#keys}│",
      "type": "uptime",
      "format": "{#blue}{formatted}{#}"
    },
    {
      "key": "  │ {#magenta}{#} shell   {#keys}│",
      "type": "shell",
      "format": "{#magenta}{pretty-name}{#}"
    },
    {
      "key": "  │ {#red}󰏖{#} pkgs    {#keys}│",
      "type": "packages",
      "format": "{#red}{all}{#}"
    },
    {
      "key": "  │ {#yellow}󰉉{#} disk    {#keys}│",
      "type": "disk",
      "folders": "/",
      "format": "{#yellow}{size-used} | {size-total}"
    },
    {
      "key": "  │ {#green}󰩟{#} network {#keys}│",
      "type": "localip",
      "format": "{#green}{ipv4} ({ifname}){#}"
    },
    {
      "key": "  ├───────────┤",
      "type": "custom"
    },
    {
      "key": "  │ {#white}{#} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "  ╰───────────╯",
      "type": "custom"
    }
  ]
}
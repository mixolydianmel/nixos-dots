default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
	include "us(basic)"
    name[Group1]= "English (US)";
    name[Group2]= "Shaw JAFL";

    key <TLDE>	{[   grave,	 asciitilde	],
				 [	 periodcentered,  U26AC ]};
    key <AE01>	{[	 1,	 exclam		],
				 [	 U10476,  1		]};
    key <AE02>	{[	 2,	 at		],
				 [	 U1046C,  2		]};
    key <AE03>	{[	 3,	 numbersign	],
				 [	 U1046B,  3		]};
    key <AE04>	{[	 4,	 dollar		],
				 [	 U1045C,  4		]};
    key <AE05>	{[	 5,	 percent	],
				 [	 U10456,  5		]};
    key <AE06>	{[	 6,	 asciicircum	],
				 [	 U10457,  6		]};
    key <AE07>	{[	 7,	 ampersand	],
				 [	 U10459,  7		]};
    key <AE08>	{[	 8,	 asterisk	],
				 [	 U10458,  8		]};
    key <AE09>	{[	 9,	 parenleft	],
				 [	 U10461,  9		]};
    key <AE10>	{[	 0,	 parenright	],
				 [	 U10454,  0		]};

    key <AD01>	{[	 q,	 Q		],
				 [	 U1046D,  U10478	]};
    key <AD02>	{[	 w,	 W		],
				 [	 U10477,  U10479	]};
    key <AD03>	{[	 e,	 E		],
				 [	 U10475,  U1047F	]};
    key <AD04>	{[	 r,	 R		],
				 [	 U10471,  U1047A	]};
    key <AD05>	{[	 t,	 T		],
				 [	 U10473,  U1047B	]};
    key <AD06>	{[	 y,	 Y		],
				 [	 U10453,  yen	]};
    key <AD07>	{[	 u,	 U		],
				 [	 U1045E,  EuroSign	]};
    key <AD08>	{[	 i,	 I		],
				 [	 U10464,  U203D	]};
    key <AD09>	{[	 o,	 O		],
				 [	 U10465,  degree	]};
    key <AD10>	{[	 p,	 P		],
				 [	 U10452,  percent	]};
    key <AD11>	{[ bracketleft,	 braceleft	],
				 [	 U10462,  semicolon	]};
    key <AD12>	{[ bracketright, braceright	],
				 [	 U10463,  apostrophe	]};

    key <AC01>	{[	 a,	 A		],
				 [	 U1046A,  at	]};
    key <AC02>	{[	 s,	 S		],
				 [	 U10468,  asterisk	]};
    key <AC03>	{[	 d,	 D		],
				 [	 U10466,  dollar	]};
    key <AC04>	{[	 f,	 F		],
				 [	 U10469,  U1047C	]};
    key <AC05>	{[	 g,	 G		],
				 [	 U10467,  sterling	]};
    key <AC06>	{[	 h,	 H		],
				 [	 U10450,  numbersign	]};
    key <AC07>	{[	 j,	 J		],
				 [	 U1046F,  ellipsis	]};
    key <AC08>	{[	 k,	 K		],
				 [	 U10451,  guillemotleft	 ]};
    key <AC09>	{[	 l,	 L		],
				 [	 U1046E,  guillemotright ]};
    key <AC10>	{[ semicolon,	 colon		],
				 [	 U10455,  colon	]};
    key <AC11>	{[ apostrophe,	 quotedbl	],
				 [	 U1045B,  quotedbl	]};
    key <BKSL>	{[ backslash,	 bar		],
				 [	 U10460,  slash		]};

    key <AB01>	{[	 z,	 Z		],
				 [	 U1047E,  U1047D	]};
    key <AB02>	{[	 x,	 X		],
				 [	 U10472,  exclam	]};
    key <AB03>	{[	 c,	 C		],
				 [	 U10474,  asciicircum	]};
    key <AB04>	{[	 v,	 V		],
				 [	 U10470,  parenleft	]};
    key <AB05>	{[	 b,	 B		],
				 [	 U1045A,  parenright	]};
    key <AB06>	{[	 n,	 N		],
				 [	 U1045D,  endash	]};
    key <AB07>	{[	 m,	 M		],
				 [	 U1045FF, emdash	]};
    key <AB08>	{[   comma,	 less		],
				 [	 comma,  U2039	]};
    key <AB09>	{[  period,	 greater	],
				 [	period,  U203A	]};

	key <MENU>  {[	ISO_NextGroup	 ]};
};
